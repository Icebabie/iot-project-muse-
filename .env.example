# Frontend environment (copy to .env.local for local dev; set the same
# variable in Vercel -> Project -> Settings -> Environment Variables).
# URL of the deployed FastAPI backend. In production this MUST be the real
# backend URL — the code only falls back to localhost in `vite dev`.
VITE_API_BASE_URL=http://localhost:8000
VITE_DEVICE_ID=ESP32-001
