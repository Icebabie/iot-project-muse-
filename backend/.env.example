# Copy to .env for local overrides. Never commit a real .env or secrets.
# Local dev default (SQLite file backend/water_quality.db) needs no setting:
# DATABASE_URL=sqlite:///./water_quality.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/water_quality
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
DEVICE_ONLINE_WINDOW_SECONDS=180
DEFAULT_DEVICE_ID=ESP32-001
# ML_MODEL_PATH=../results/best_model.pt
# ML_SCALER_PATH=../results/scaler.json
